        <logo name="barn" texture="textures/barn.dds" l10n="farmIconColor_logo_barn" />
        <logo name="tractor" texture="textures/tractor.dds" l10n="farmIconColor_logo_tractor" />
        <logo name="vine" texture="textures/vine.dds" l10n="farmIconColor_logo_vine" />
        <logo name="carrot" texture="textures/carrot.dds" l10n="farmIconColor_logo_carrot" />
        <logo name="square_ball" texture="textures/square_ball.dds" l10n="farmIconColor_logo_square_ball" />
        <logo name="barrier" texture="textures/barrier.dds" l10n="farmIconColor_logo_barrier" />
        <logo name="round_ball" texture="textures/round_ball.dds" l10n="farmIconColor_logo_round_ball" />
