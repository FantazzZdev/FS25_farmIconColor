<?xml version="1.0" encoding="utf-8" standalone="no"?>
<farmIconColor>
    <!--
        Configuration principale de farmIconColor.
        Pour ajouter un logo : ajoute le fichier DDS dans textures/ puis déclare-le dans <logos>.
        Les logos doivent être en blanc pur avec fond transparent pour être recolorés proprement.
    -->

    <settings>
        <applyToFarmLogo value="true" />
        <applyToPlayerCursor value="true" />
        <applyToFarmland value="true" />
        <applyToFieldNumbers value="true" />
        <applyToVehicleHotspots value="true" />
        <applyToObjectHotspots value="true" />
        <applyToFarmMenuLogo value="true" />
        <allowCustomLogos value="true" />
    </settings>

    <defaultColor value="#FFFFFF" />

    <logos>
        <!--
            Ordre du sélecteur en jeu :
            le premier <logo> ci-dessous est affiché en premier,
            le deuxième est affiché en deuxième, etc.
            Pour changer l'ordre, déplace simplement les lignes <logo>.
        -->
        <logo name="chicken" texture="textures/chicken.dds" />
        <logo name="sheep" texture="textures/sheep.dds" />
        <logo name="cow" texture="textures/cow.dds" />
        <logo name="buffalo" texture="textures/buffalo.dds" />
        <logo name="horse" texture="textures/horse.dds" />
        <logo name="pig" texture="textures/pig.dds" />
        <logo name="chainsaw" texture="textures/chainsaw.dds" />
        <logo name="barn" texture="textures/barn.dds" />
        <logo name="tractor" texture="textures/tractor.dds" />
        <logo name="vine" texture="textures/vine.dds" />
        <logo name="carrot" texture="textures/carrot.dds" />
        <logo name="square_ball" texture="textures/square_ball.dds" />
        <logo name="barrier" texture="textures/barrier.dds" />
        <logo name="round_ball" texture="textures/round_ball.dds" />
        <logo name="bee" texture="textures/bee.dds" />
        <logo name="boot" texture="textures/boot.dds" />
        <logo name="watering_can" texture="textures/watering_can.dds" />
        <logo name="wheelbarrow" texture="textures/wheelbarrow.dds" />
        <logo name="mechanical_shovel" texture="textures/mechanical_shovel.dds" />
        <logo name="log" texture="textures/log.dds" />
        <logo name="crate" texture="textures/crate.dds" />
        <logo name="tight" texture="textures/tight.dds" />
        <logo name="plow" texture="textures/plow.dds" />
        <logo name="combine" texture="textures/combine.dds" />
        <logo name="trailer" texture="textures/trailer.dds" />
        <logo name="warehouse" texture="textures/warehouse.dds" />
        <logo name="honey" texture="textures/honey.dds" />
        <logo name="windmill" texture="textures/windmill.dds" />
        <logo name="cotton" texture="textures/cotton.dds" />
